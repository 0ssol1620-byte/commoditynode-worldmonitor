---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { coverWebpSources } from '../lib/cover-webp';
import {
  absoluteUrl,
  belongsToActiveSite,
  isCommodityNode,
  postPath,
  site,
} from '../lib/site-variant';

const posts = (await getCollection('blog'))
  .filter(belongsToActiveSite)
  .sort(
    (a, b) =>
      Number(b.data.pinned ?? false) - Number(a.data.pinned ?? false) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

// Committed covers have generated .webp / -640.webp siblings (guarded by
// tests/blog-cover-webp.test.mjs); coverWebpSources() returns null when the
// siblings don't exist (e.g. deploy-generated /blog/og/*.png covers). Cards
// render at ~340-540px, so the 640w thumb covers 1x displays and the full
// WebP covers high-DPI ones.

const DEFAULT_AUTHOR = site.defaultAuthor;
const DEFAULT_AUTHOR_URL = isCommodityNode
  ? undefined
  : 'https://www.worldmonitor.app/blog/authors/elie-habib/';
const DEFAULT_AUTHOR_ID = DEFAULT_AUTHOR_URL ? `${DEFAULT_AUTHOR_URL}#person` : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${absoluteUrl(site.indexPath)}#publication`,
  "name": site.publication,
  "description": site.description,
  "url": absoluteUrl(site.indexPath),
  "inLanguage": "en-US",
  "publisher": {
    "@type": "Organization",
    "@id": `${site.origin}/#organization`,
    "name": site.name,
    "url": site.origin,
    "logo": {
      "@type": "ImageObject",
      "url": absoluteUrl(site.markUrl)
    }
  },
  "blogPost": posts.map(post => {
    const authorName = post.data.author || DEFAULT_AUTHOR;
    const authorUrl = post.data.authorUrl || (authorName === DEFAULT_AUTHOR ? DEFAULT_AUTHOR_URL : undefined);

    return {
      "@type": "BlogPosting",
      "@id": `${absoluteUrl(postPath(post.id))}#article`,
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      ...(post.data.modifiedDate ? { "dateModified": post.data.modifiedDate.toISOString() } : {}),
      "author": {
        "@type": "Person",
        "name": authorName,
        ...(authorUrl ? { "url": authorUrl } : {}),
        ...(authorName === DEFAULT_AUTHOR ? { "@id": DEFAULT_AUTHOR_ID } : {})
      },
      "url": absoluteUrl(postPath(post.id)),
      "image": post.data.heroImage
        ? absoluteUrl(post.data.heroImage)
        : absoluteUrl(site.markUrl)
    };
  })
};
---

<Base
  title={site.publication}
  description={site.description}
  metaTitle={isCommodityNode
    ? 'CommodityNode Research | Commodity Impact Intelligence'
    : 'World Monitor Blog | Global Intelligence & OSINT'}
  jsonLd={jsonLd}
>
  <div class="blog-hero">
    {isCommodityNode ? (
      <>
        <p class="section-label">Commodity impact research</p>
        <h1>Trace commodity shocks from source event to market exposure.</h1>
        <p class="subtitle">
          CommodityNode connects benchmarks, assets, routes, companies, and source evidence so each claim can be checked before it is used.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={site.liveUrl}>Open live intelligence</a>
          <a class="secondary-action" href="/methodology/">Read the methodology</a>
        </div>
      </>
    ) : (
      <>
        <p class="section-label">Intelligence feed</p>
        <h1>Noise. Signal. Blog.</h1>
        <p class="subtitle">{site.description}</p>
      </>
    )}
  </div>
  <div class="blog-list">
    <div class="post-grid">
      {posts.map((post) => {
        const cover = coverWebpSources(post.data.heroImage);
        return (
        <a href={postPath(post.id)} class:list={['post-card', { pinned: post.data.pinned }]}>
          {post.data.heroImage && (
            <picture>
              {cover && (
                <source
                  type="image/webp"
                  srcset={`${cover.webp640} 640w, ${cover.webp} 1200w`}
                  sizes="(max-width: 740px) calc(100vw - 3rem), 350px"
                />
              )}
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="post-card-img"
                loading="lazy"
                width="600"
                height="315"
              />
            </picture>
          )}
          <div class="tag">
            {post.data.pinned && <span class="pin">Selected</span>}
            {post.data.audience}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</Base>
